# Free registration: https://fred.stlouisfed.org/docs/api/api_key.html
#
# Setup:
#   cp .env.example .env
#
# Then paste your key (exactly 32 lowercase alphanumeric characters, e.g. abc123...):
#   FRED_API_KEY=your32characterlowercasekeyhere
#
# Do NOT use placeholder text like "your_fred_api_key_here" — the API will reject it.
FRED_API_KEY=
